TOURIST_DB_PATH=data/tourist.sqlite3
TOURIST_USER_AGENT=TouristPlannerPersonalPOC/0.2 (local personal use)
TOURIST_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
TOURIST_OVERPASS_URL=https://overpass-api.de/api/interpreter
OPENROUTESERVICE_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
OPENAI_API_KEY=

# A GTFS zip read locally for transit legs (WF-038). Free and offline: no request
# is made and nothing is billed. Taipei is on Taiwan's TDX platform, which needs a
# free account; the open MobilityData catalogue has no Taipei feed.
TOURIST_GTFS_PATH=data/gtfs/transit.zip
