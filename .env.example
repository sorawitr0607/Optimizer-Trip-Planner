# Copy to `.env` and fill in. `.env` is gitignored; this file never holds a value.
#
# Note what reads what, because it is not obvious: **nothing in travel_planner/
# reads this file**. The planner reads `secrets.local.json` through
# `credentials.load_local_credentials()`, which is why provider keys belong there.
# A `.env` is for the tools that do read one — `vercel dev`, `vercel env pull`,
# and `set -a; . ./.env; set +a` in a shell.

# --- Hosted Postgres (Supabase) --------------------------------------------
# Session mode (5432): migrations, DDL and the worker. Supports prepared
# statements and long transactions.
POSTGRES_URL_NON_POOLING=
# Transaction mode (6543): short-lived serverless requests. pgstore.py disables
# psycopg's automatic prepared statements so this endpoint works.
POSTGRES_URL=

# The planner reads THIS to choose Postgres over the local file, and it overrides
# whatever path it was handed. Leave it unset unless a specific command is meant
# to run against the hosted database: exported in a shell it has twice redirected
# test runs into production. See the hosted-port section of CLAUDE.md.
# TOURIST_DB_URL=

# --- Supabase project -------------------------------------------------------
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe: constrained by row-level security.
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Bypasses every row-level security policy. Never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Planner settings (not secret) ------------------------------------------
TOURIST_DB_PATH="data/tourist.sqlite3"
TOURIST_USER_AGENT="TouristPlannerPersonalPOC/0.2 (local personal use)"
TOURIST_NOMINATIM_URL="https://nominatim.openstreetmap.org/search"
# Comma-separated and tried in order; only a refused connection moves to the next.
TOURIST_OVERPASS_URL="https://overpass-api.de/api/interpreter"
TOURIST_GTFS_PATH="data/gtfs/transit.zip"

# --- Paid providers ---------------------------------------------------------
# Blank by default: the planner is free unless a priced control is pressed.
OPENROUTESERVICE_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
OPENAI_API_KEY=
