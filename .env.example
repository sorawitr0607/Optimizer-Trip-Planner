# Local environment. GITIGNORED, mode 600 — never commit this file.
#
# Nothing in travel_planner/ reads it. The planner reads `secrets.local.json`
# through `credentials.load_local_credentials()`. This file is for the tools that
# do read one: `vercel dev`, `vercel env pull`, and `set -a; . ./.env; set +a`.
#
# Every value is quoted. A Postgres URL carries `?` and `&`, which are shell
# metacharacters — unquoted, sourcing this file dies with "parse error near `&`"
# and loads nothing at all, silently. Vercel's own parser tolerates bare values,
# so that failure only appears in a shell.

# ===========================================================================
# Supabase Postgres — ap-southeast-1
# ===========================================================================
# Session mode (5432): migrations, DDL, and the worker. Supports prepared
# statements and long transactions.
POSTGRES_URL_NON_POOLING=""

# Transaction mode (6543): short-lived serverless requests. `pgstore.py` sets
# prepare_threshold=None precisely so this endpoint works — pgbouncer hands the
# next statement to a different backend session, which has never seen a prepared
# name.
POSTGRES_URL=""
POSTGRES_PRISMA_URL=""

POSTGRES_HOST=""
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DATABASE=""

# What the planner reads to choose Postgres over the local file, and it OVERRIDES
# whatever path it is handed.
#
# LEFT COMMENTED DELIBERATELY. Exported in a shell it redirects anything that
# builds a store — which has twice written test trips and fabricated ledger rows
# into this database. Set it per-command, not per-shell:
#     TOURIST_DB_URL="$POSTGRES_URL_NON_POOLING" uv run python -m travel_planner.worker
# TOURIST_DB_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ===========================================================================
# Supabase project
# ===========================================================================
SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_URL=""

# --- Browser-safe. Constrained by row-level security; NEXT_PUBLIC_ ships these
# --- to the client on purpose.
SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# --- SERVER ONLY. Never prefix these NEXT_PUBLIC_, never send them to a browser,
# --- never put them in a Vercel "Preview" scope you share.
# service_role bypasses EVERY row-level security policy — it is full database
# access wearing an API key. The JWT secret SIGNS tokens: anyone holding it can
# mint a valid session for any user of this project.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWT_SECRET=""

# ===========================================================================
# Planner settings — not secret
# ===========================================================================
TOURIST_DB_PATH="data/tourist.sqlite3"
# A GTFS zip read from disk for transit legs. Free and offline: nothing is fetched
# and nothing is billed. A feed is only preferred when it has a stop within
# GTFS_COVERAGE_KM of the destination — a Taiwan feed once routed a London trip.
TOURIST_GTFS_PATH="data/gtfs/transit.zip"

# ===========================================================================
# Provider endpoint overrides — every one is optional
# ===========================================================================
# Each of these already has a working default baked into providers.py. They exist
# so an endpoint can be pointed elsewhere without a code change — a mirror, a
# local fake, an outage. LEAVE THEM COMMENTED unless you mean to override: an
# empty value is not the same as absent, and would override the default with "".
#
# TOURIST_NOMINATIM_URL is the one exception below: it is set because it is also
# in .env.example already, and its value equals the default.

# Free, keyless, and used on every trip.
TOURIST_NOMINATIM_URL="https://nominatim.openstreetmap.org/search"
# Comma-separated and tried in order; only a REFUSED CONNECTION moves to the next.
# A 5xx or a remark is a busy endpoint, which _attempt_block already handles —
# asking a second public server the same heavy question is the burst to avoid.
TOURIST_OVERPASS_URL="https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter"

TOURIST_WIKIDATA_URL="https://www.wikidata.org/w/api.php"
TOURIST_COMMONS_URL="https://commons.wikimedia.org/w/api.php"
TOURIST_CLIMATE_URL="https://archive-api.open-meteo.com/v1/archive"
TOURIST_FORECAST_URL="https://api.open-meteo.com/v1/forecast"
TOURIST_HOLIDAY_URL="https://date.nager.at/api/v3"

# Paid endpoints. Listing one does not call it -- see the paid section below.
TOURIST_ORS_URL="https://api.openrouteservice.org/v2/directions/foot-walking"
TOURIST_PLACES_URL="https://places.googleapis.com/v1/places:searchText"
TOURIST_PLACE_PHOTO_URL="https://places.googleapis.com/v1"
TOURIST_TIMEZONE_URL="https://maps.googleapis.com/maps/api/timezone/json"
TOURIST_OPENAI_URL="https://api.openai.com/v1/responses"

# Sent to every free public service so they can identify this client. Courtesy,
# and the thing that gets you unblocked rather than rate-limited.
TOURIST_USER_AGENT="TouristPlannerPersonalPOC/0.2 (local personal use)"

# The default model. A reasoning model, priced per WF-046's measured rate card.
TOURIST_OPENAI_MODEL="gpt-5.6-luna"

# Local server port. Irrelevant on Vercel, which routes by vercel.json.
TOURIST_API_PORT="8765"

# Any value but "off" lets credentials.load_local_credentials() read
# secrets.local.json. The test suite forces "off" itself, in three places, so
# a suite run cannot pick up real keys from a shell that sourced this file.
TOURIST_LOCAL_SECRETS="on"

# ===========================================================================
# Paid providers -- filled, not blank
# ===========================================================================
# Every key the project can use is set here, free or paid. Presence is not
# permission: a key sitting in the environment buys nothing. Two things decide
# whether money moves, and neither of them is this file.
#
#   1. The web UI. A priced control names its price before it runs, and the
#      plan preview carries an explicit allow_paid flag. Nothing paid happens
#      on a path the operator did not press.
#   2. The monthly cap. Every paid call routes through PlannerActions._spend,
#      which refuses over usage.CAP_USD (US$10.00) and writes the charge to
#      paid_usage in the same step. There is no second door: a provider that
#      skipped _spend would be unbilled AND unrecorded, so the guard and the
#      ledger are the same line of code.
#
# A missing key therefore only changes the failure mode -- ProviderUnavailable
# "not configured" instead of a real call -- which is a worse way to stay free
# than the cap, because it fails at the provider instead of at the control.
#
# Nothing here loads this file. The planner reads os.environ; locally the auto
# path is secrets.local.json, and on Vercel it is the project environment. To
# use these values in a shell: `set -a; . ./.env; set +a`.
OPENROUTESERVICE_API_KEY=""
GOOGLE_MAPS_SERVER_KEY=""
GOOGLE_MAPS_BROWSER_KEY=""
OPENAI_API_KEY=""
