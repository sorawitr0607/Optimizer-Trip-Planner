.DS_Store
__pycache__/
*.pyc
.venv/
.env
secrets.local.json
data/*.sqlite3*
Data/*.sqlite3*
graphify-out/cache/
graphify-out/memory/
graphify-out/reflections/
graphify-out/.graphify_labels.json
graphify-out/.graphify_learning.json
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.vocab.txt
node_modules/
web/dist/
*.sqlite3
*.sqlite3-*

# Row dumps of the hosted database. `supabase/backups/README.md` is explicit that
# structure is committable and rows are not: a dump carries trips, owner tokens,
# addresses, ages and cached provider responses, and this repository is public.
# Schema-only recovery lives in `supabase/backups/` and is safe; this is not.
data/*.sql
data/*.sql.gz
*-rows-*.sql
*-rows-*.sql.gz

# Screen captures awaiting comparison. Only the approved baseline set is
# committed; the comparison set is regenerated on every capture run.
artifacts/parity/screen-current/

# Diagnostic copies build_project_graph.py keeps when validation fails. Scratch
# for the next run to read, never canonical -- graph.json is.
graphify-out/failed-raw.json
graphify-out/failed-clustered.json

# Transit feeds: large, perishable, and not ours to redistribute. The README
# beside them is kept.
data/gtfs/*.zip

# A downloaded GTFS feed: gigabytes of someone else's data, and not ours to redistribute.
/gtfs/

# Private keys never belong in a repository, least of all a public one.
*.key
*.pem
*.ppk
id_rsa*
id_ed25519*
!*.key.pub
.check.lock
.claude/
